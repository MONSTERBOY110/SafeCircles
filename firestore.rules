rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True iff `field` either didn't exist before, or its value is unchanged.
    // Used to lock verification fields once they are first set.
    function lockedAfterFirstSet(field) {
      return !(field in resource.data)
          || (field in request.resource.data
              && resource.data[field] == request.resource.data[field]);
    }

    // True iff verification_status is unchanged, was unset before, or is
    // transitioning PENDING -> VERIFIED. No other transitions allowed.
    function verificationStatusOk() {
      let prev = resource.data.get('verification_status', null);
      let next = request.resource.data.get('verification_status', null);
      return prev == next
          || prev == null
          || (prev == 'PENDING' && next == 'VERIFIED');
    }

    // True iff isVerified is unchanged or transitioning false -> true.
    function isVerifiedOk() {
      let prev = resource.data.get('isVerified', false);
      let next = request.resource.data.get('isVerified', false);
      return prev == next || (prev == false && next == true);
    }

    // users — verification fields are immutable once set; only the user
    // themselves can update their own doc.
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == userId;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && lockedAfterFirstSet('gender')
                    && lockedAfterFirstSet('kycProvider')
                    && verificationStatusOk()
                    && isVerifiedOk();

      // No client-side deletes — admin tooling only.
      allow delete: if false;
    }

    // Other collections — auth required, no per-field locking yet.
    match /trips/{tripId} {
      allow read, write: if request.auth != null;
    }

    match /safe_circles/{circleId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    match /live_locations/{userId} {
      allow read, write: if request.auth != null;
    }

    match /alerts/{alertId} {
      allow read, write: if request.auth != null;
    }

    match /safety_pings/{pingId} {
      allow read, write: if request.auth != null;
    }

    match /trip_logs/{logId} {
      allow read, write: if request.auth != null;
    }
  }
}
