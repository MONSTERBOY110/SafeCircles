# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# App Configuration
VITE_APP_URL=http://localhost:3000
VITE_MAPS_API_KEY=your_maps_key_here

# Feature Flags
VITE_ENABLE_VERIFICATION=true
VITE_ENABLE_MATCHING=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_LOCATION_TRACKING=true

# Tunnel Mode (Cloudflared / ngrok / localtunnel)
VITE_TUNNEL_MODE=0

# Cloudinary CDN base for scroll frames
VITE_CLOUDINARY_FRAMES_BASE=https://res.cloudinary.com/your_cloud/image/upload/f_auto,q_auto,w_1920/scframes

# Firebase Cloud Messaging Web Push VAPID public key
VITE_FIREBASE_VAPID_KEY=your_vapid_public_key
